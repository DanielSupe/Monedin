{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "packages/config/tsconfig.base.json",
    "packages/config/eslint.config.js",
    "packages/config/prettier.config.js"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "vite.config.ts",
        "index.html",
        "public/**",
        "prisma/schema.prisma"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "eslint.config.js",
        "package.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "prisma/schema.prisma"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "package.json",
        ".env.example",
        "prisma/schema.prisma"
      ],
      "outputs": []
    },
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}
