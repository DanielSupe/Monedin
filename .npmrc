# El aislamiento estricto de pnpm (decision 1 del design) viene de su layout de
# node_modules: una app solo puede importar lo que declara en su package.json.
# Eso lo da pnpm por defecto y no hace falta configurar nada.
#
# NO poner `hoist=false`: obliga a pnpm a crear un symlink por dependencia y en
# Windows sin Modo desarrollador la instalacion falla con EPERM. El aislamiento
# de nuestras apps no depende de esa opcion.
strict-peer-dependencies=false
auto-install-peers=true
