# ---------------------------------------------------------------------------
# Plantilla de entorno de Monedin. Copiar a `.env` y completar.
#
#   cp .env.example .env
#
# Este archivo SI se versiona; `.env` NO. Ningun valor de aqui es sensible.
#
# La variable ENV_FILE (que no se declara aqui, porque dice donde esta este
# archivo) permite apuntar a otra ruta: ENV_FILE=/etc/monedin/produccion.env
#
# Regla: toda variable que la API declare en su esquema de entorno
# (apps/api/src/config/env.schema.ts) tiene que aparecer aqui. Hay un test que
# lo comprueba y falla nombrando la variable que falte.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------

# Entorno de ejecucion. Uno de: development | test | production
NODE_ENV=development

# Puerto en el que escucha la API.
API_PORT=3000

# Cadena de conexion a PostgreSQL. SECRETO: su valor nunca se imprime.
# En desarrollo apunta al contenedor de docker-compose.
DATABASE_URL=postgresql://monedin:monedin@localhost:5432/monedin

# Origen del front, usado para politicas de origen y enlaces absolutos.
WEB_ORIGIN=http://localhost:5173

# Nivel de log. Uno de: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Infraestructura local (docker-compose) --------------------------------
# La API no lee estas variables: las consume `docker-compose.yml`. Deben ser
# coherentes con DATABASE_URL.

POSTGRES_USER=monedin
POSTGRES_PASSWORD=monedin
POSTGRES_DB=monedin
POSTGRES_PORT=5432
ADMINER_PORT=8080

# --- Front -----------------------------------------------------------------

# Puerto del servidor de desarrollo de Vite.
WEB_PORT=5173
