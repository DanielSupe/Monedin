# ---------------------------------------------------------------------------
# Plantilla de entorno de Monedin. Copiar a `.env` y completar.
#
#   cp .env.example .env
#
# Este archivo SI se versiona; `.env` NO. Ningun valor de aqui es sensible.
#
# La variable ENV_FILE (que no se declara aqui, porque dice donde esta este
# archivo) permite apuntar a otra ruta: ENV_FILE=/etc/monedin/produccion.env
#
# Regla: toda variable que la API declare en su esquema de entorno
# (apps/api/src/config/env.schema.ts) tiene que aparecer aqui. Hay un test que
# lo comprueba y falla nombrando la variable que falte.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------

# Entorno de ejecucion. Uno de: development | test | production
NODE_ENV=development

# Puerto en el que escucha la API.
API_PORT=3000

# Cadena de conexion a PostgreSQL. SECRETO: su valor nunca se imprime.
# En desarrollo apunta al contenedor de docker-compose.
DATABASE_URL=postgresql://monedin:monedin@localhost:5432/monedin

# Origen del front, usado para politicas de origen y enlaces absolutos.
WEB_ORIGIN=http://localhost:5173

# Nivel de log. Uno de: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Base de datos que usa la bateria de tests. DEBE ser distinta de DATABASE_URL:
# los tests borran y recrean su esquema. SECRETO.
TEST_DATABASE_URL=postgresql://monedin:monedin@localhost:5432/monedin_test

# --- Almacen de imagenes ---------------------------------------------------
# Avatares, fotos de premios y evidencias de tareas.
#
# Desarrollo puede ir contra MinIO (por defecto aqui) o contra el S3 real,
# dejando S3_ENDPOINT vacio y poniendo credenciales de verdad en TU `.env`
# —nunca aqui—.
#
# Los TESTS van SIEMPRE contra MinIO, pase lo que pase con lo de arriba: su
# arranque VACIA el bucket que se le indique, asi que tienen su propio endpoint
# (TEST_S3_ENDPOINT) que no admite estar vacio. No hay forma de escribir ahi
# "el S3 de AWS", y esa es justamente la defensa.

# Region del bucket.
S3_REGION=us-east-1

# Bucket de trabajo.
S3_BUCKET_NAME=monedin-dev

# Bucket de la bateria de tests. DEBE ser distinto de S3_BUCKET_NAME: los tests
# VACIAN su bucket entre pasadas.
TEST_S3_BUCKET_NAME=monedin-test

# Donde vive el bucket de tests. SIEMPRE un almacen propio (MinIO), nunca AWS.
TEST_S3_ENDPOINT=http://localhost:9000

# Direccion del almacen. VACIO = el S3 real de AWS. Con valor, un
# S3-compatible propio (MinIO en local).
S3_ENDPOINT=http://localhost:9000

# Credenciales del almacen. SECRETO: su valor nunca se imprime.
# Estas son las de MinIO en local, que no dan acceso a nada fuera de tu maquina.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Infraestructura local (docker-compose) --------------------------------
# La API no lee estas variables: las consume `docker-compose.yml`. Deben ser
# coherentes con DATABASE_URL y con las de S3 de arriba.

POSTGRES_USER=monedin
POSTGRES_PASSWORD=monedin
POSTGRES_DB=monedin
POSTGRES_PORT=5432
ADMINER_PORT=8080

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Front -----------------------------------------------------------------

# Puerto del servidor de desarrollo de Vite.
WEB_PORT=5173
