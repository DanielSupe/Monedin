// Esquema de datos de Monedin.
//
// Prisma 7 NO admite `url` dentro de datasource: la conexion se declara en
// prisma.config.ts. Y el generador necesita moduleFormat/importFileExtension
// para que el cliente generado no importe sus propios archivos con extension
// ".ts" literal, cosa que tsx tolera y `node` sobre el JS compilado no.
// Ver la decision 6 del design de add-data-model.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Ciclo de vida de una tarea.
///
/// NO existe un estado de rechazo: rechazar devuelve la tarea a PENDING para que
/// el nino la reintente. Un valor de enum que ningun flujo produce es una
/// invitacion a que alguien lo use mal.
enum TaskStatus {
  PENDING
  COMPLETED
  APPROVED
}

/// Ciclo de vida de un canje. Aqui el rechazo SI es terminal: el nino no pierde
/// monedas al rechazarse, porque el descuento solo ocurre al aprobar.
enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// De donde viene un movimiento de monedas.
enum CoinReason {
  TASK_APPROVED
  REDEMPTION_APPROVED
  MANUAL_ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

/// Un padre. SOLO un padre.
///
/// El nino no tiene fila aqui: vive entero en ChildProfile con su PIN. Por eso
/// no hay columna de rol — valdria siempre PARENT. Ver la decision 1 del design.
model User {
  id           String   @id @default(cuid(2))
  name         String
  email        String   @unique
  /// Hash opaco. El algoritmo lo decide `add-authentication`.
  passwordHash String
  image        String?

  /// PIN de adulto. La contrasena vincula un dispositivo; el PIN activa el
  /// perfil en el dia a dia. Ver la decision 3 del design de
  /// add-profile-selection.
  pinHash String

  /// Bloqueo por intentos fallidos. Ver la decision 4 del design de
  /// add-authentication: se bloquea por identidad, no por direccion IP, porque
  /// en una casa todos comparten IP.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Bloqueo del PIN, SEPARADO del de la contrasena. Un nino aporreando el PIN
  /// de su madre no puede dejarla sin poder entrar con su contrasena.
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children ChildProfile[]
  tasks    Task[]
  rewards  Reward[]
  sessions Session[]

  @@map("users")
}

/// Un nino, entero.
///
/// Nombre, credencial, saldo y datos de perfil en una sola tabla: actualizar un
/// nino ya no toca dos tablas en transaccion.
model ChildProfile {
  id      String  @id @default(cuid(2))
  name    String
  /// Hash opaco del PIN. El algoritmo y la longitud los decide
  /// `add-authentication`; la columna guarda un hash de longitud fija.
  pinHash String
  /// Saldo actual. Fuente de verdad, con CHECK (coins >= 0) en la migracion.
  /// Se modifica SIEMPRE con increment/decrement, nunca leyendo y escribiendo.
  coins   Int     @default(0)
  age     Int?
  avatar  String?

  /// Bloqueo del perfil por PIN fallido. Es por perfil, no por dispositivo: que
  /// un hermano se bloquee no debe dejar fuera a los demas.
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?

  /// Baja logica: oculta de los listados sin destruir historial.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parentId String
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  tasks            Task[]
  assignments      RewardAssignment[]
  redemptions      RewardRedemption[]
  coinTransactions CoinTransaction[]
  sessions         Session[]

  @@index([parentId, deletedAt])
  @@map("child_profiles")
}

// ---------------------------------------------------------------------------
// Tareas
// ---------------------------------------------------------------------------

/// Una tarea asignada a UN nino. Asignarla a varios crea varias filas.
model Task {
  id          String     @id @default(cuid(2))
  title       String
  description String?
  /// Lo que gana el nino al aprobarse. CHECK de rango en la migracion.
  coins       Int
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?

  /// Identificador del REPARTO: las filas creadas en el mismo POST lo
  /// comparten. Lo genera la aplicacion antes de insertar, porque hace falta
  /// conocerlo para que todas las filas lleven el mismo.
  ///
  /// No es opcional: una columna nullable obligaria a tratar el caso «sin
  /// reparto» en cada consulta y en cada pantalla, para siempre. Las filas
  /// anteriores se rellenaron en la migracion con su propio identificador, de
  /// modo que cada una es un reparto de una. Ver la decision 4 del design de
  /// add-tasks.
  batchId String

  /// Clave en el almacen de la foto que el nino adjunto al marcarla como hecha.
  ///
  /// OPCIONAL a proposito: la evidencia es una forma de ENSENAR el trabajo, no
  /// un peaje para declararlo hecho. Un nino sin camara a mano marca su tarea
  /// igual. Guarda la CLAVE, no una URL: las URLs de lectura se firman al
  /// serializar y caducan, asi que una guardada aqui estaria rota en una hora.
  evidenceKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Restrict)

  parentId String
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  coinTransactions CoinTransaction[]

  @@index([childId, status])
  @@index([parentId, createdAt])
  @@index([parentId, batchId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Premios y canjes
// ---------------------------------------------------------------------------

/// Un premio del catalogo del padre. Existe una vez y se asigna a varios ninos.
model Reward {
  id          String  @id @default(cuid(2))
  title       String
  description String?
  image       String?
  /// Retirada logica: deja de poder canjearse, los canjes previos siguen ahi.
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String
  parent   User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  assignments RewardAssignment[]
  redemptions RewardRedemption[]

  @@index([parentId, isActive])
  @@map("rewards")
}

/// Puente premio-nino CON PRECIO PROPIO. El mismo premio puede costarle 50 al
/// hijo mayor y 30 al menor: es intencional.
///
/// La clave compuesta impide dos asignaciones del mismo premio al mismo nino.
model RewardAssignment {
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  /// Precio para ESE nino. CHECK de rango en la migracion.
  coins Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([rewardId, childId])
  @@index([childId])
  @@map("reward_assignments")
}

/// Solicitud de canje iniciada por el nino.
model RewardRedemption {
  id String @id @default(cuid(2))
  /// SNAPSHOT del precio al solicitar. Si el padre lo cambia despues, el canje
  /// pendiente respeta el precio original. CHECK de rango en la migracion.
  coins  Int
  status RedemptionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Restrict)

  coinTransactions CoinTransaction[]

  @@index([childId, status])
  @@index([rewardId])
  @@map("reward_redemptions")
}

// ---------------------------------------------------------------------------
// Libro de monedas
// ---------------------------------------------------------------------------

/// Historial append-only de movimientos de monedas.
///
/// NO lleva updatedAt a proposito: una fila escrita no se toca. La migracion
/// instala un disparador que rechaza UPDATE y DELETE sobre esta tabla, y las
/// relaciones son Restrict para que no se pueda borrar un nino con historial.
model CoinTransaction {
  id String @id @default(cuid(2))
  /// Positivo acredita, negativo descuenta. Nunca cero.
  amount Int
  /// Saldo resultante tras aplicar el movimiento. Redundante a proposito:
  /// convierte auditar el saldo en una comparacion, no en una agregacion.
  /// Ver la decision 5 del design.
  balanceAfter Int
  reason       CoinReason
  createdAt    DateTime   @default(now())

  childId String
  child   ChildProfile @relation(fields: [childId], references: [id], onDelete: Restrict)

  /// De donde vino el movimiento, cuando vino de algo.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Restrict)

  redemptionId String?
  redemption   RewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([childId, createdAt])
  @@map("coin_transactions")
}

// ---------------------------------------------------------------------------
// Sesiones
// ---------------------------------------------------------------------------

/// Una sesion activa. Hay DOS niveles, y la fila dice cual es por su forma:
///
///   parentSessionId NULL      -> SESION DE CUENTA. Acredita que el dispositivo
///                                pertenece a esta cuenta. NO da actor.
///   parentSessionId NOT NULL  -> PERFIL ACTIVO, colgando de esa cuenta.
///     childProfileId NULL       ... el perfil del PADRE
///     childProfileId NOT NULL   ... el perfil de ese hijo
///
/// Que la cookie de cuenta no de poderes es lo que hace que la rejilla sea una
/// frontera y no una pantalla que se rodea llamando al endpoint. Ver la
/// decision 1 del design de add-profile-selection.
///
/// Guarda el HASH del identificador, nunca el identificador: quien lea esta
/// tabla entera no puede suplantar a nadie con lo que encuentre.
model Session {
  id String @id @default(cuid(2))

  /// SHA-256 del identificador que viaja en la cookie.
  tokenHash String @unique

  /// El padre dueno de la sesion. Presente SIEMPRE, tambien en las de nino:
  /// una sesion de nino siempre cuelga de la de su padre.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// En un perfil activo: nulo es el perfil del padre. En una sesion de
  /// cuenta: siempre nulo.
  childProfileId String?
  childProfile   ChildProfile? @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  /// De que sesion de cuenta cuelga este perfil. Nulo en las de cuenta.
  parentSessionId String?
  parentSession   Session?  @relation("ChildSessions", fields: [parentSessionId], references: [id], onDelete: Cascade)
  childSessions   Session[] @relation("ChildSessions")

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([childProfileId])
  @@index([expiresAt])
  @@map("sessions")
}
